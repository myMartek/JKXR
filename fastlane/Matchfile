# Die Adresse des Zertifikatsspeichers steht NICHT im Quelltext.
#
# Sie ist kein Passwort -- der Zugang haengt am SSH-Schluessel --, nennt aber
# Host, Port und Pfad einer privaten Infrastruktur. In einem oeffentlichen Repo
# ist das eine Einladung zum Abklopfen.
#
# Gesetzt in fastlane/.env.local (lokal) und als CI/CD-Variable (Runner).
git_url(ENV.fetch("MATCH_GIT_URL"))

storage_mode("git")

type("appstore")

app_identifier([ENV.fetch("APP_IDENTIFIER", "de.martek.jkxr")])

# visionOS wird unter dem ios-Plattformprofil ausgeliefert -- das
# App-Store-Profil deckt iPhone, iPad und Vision Pro gemeinsam ab.
# Siehe die Lane bootstrap_signing.
platform("ios")
