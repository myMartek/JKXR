<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Diese beiden Schlüssel stehen hier und nicht als INFOPLIST_KEY_… in
	    project.yml: Xcode kennt für INFOPLIST_KEY_ nur eine feste Liste, und
	    UIFileSharingEnabled gehört nicht dazu. Es wird dann kommentarlos
	    verworfen — die fertige Info.plist enthielt den Schlüssel schlicht nicht.

	    Beide werden gebraucht, einer allein genügt nicht:
	      UIFileSharingEnabled              macht Documents/ überhaupt sichtbar
	      LSSupportsOpeningDocumentsInPlace  erlaubt Bearbeiten statt Kopieren

	    Xcode mischt die generierten Schlüssel in diese Datei, solange
	    GENERATE_INFOPLIST_FILE gesetzt bleibt. Alles Übrige steht daher
	    weiterhin in project.yml.
	-->
	<!--
	    Räumliche Controller.
	
	    Ohne SpatialGamepad reicht das System das Sense-Paar als EIN
	    zusammengefasstes MFi-Gamepad durch und weist es nie als räumliches
	    Zubehör aus. Auf dem Gerät gemessen: GCSpatialAccessory antwortete mit
	    null Geräten, während das Paar in der gewöhnlichen Controllerliste stand
	    — "PlayStation VR2 Sense Controllers (L/R)", Kategorie MFi.
	
	    Das Gamepad-Profil bleibt daneben stehen: die Fortbewegung läuft
	    weiterhin über diesen Griff, und eine Sitzung mit einem gewöhnlichen
	    Controller soll unberührt bleiben.
	-->
	<key>GCSupportedGameControllers</key>
	<array>
		<dict><key>ProfileName</key><string>ExtendedGamepad</string></dict>
		<dict><key>ProfileName</key><string>SpatialGamepad</string></dict>
		<dict><key>ProfileName</key><string>MicroGamepad</string></dict>
		<dict><key>ProfileName</key><string>DirectionalGamepad</string></dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>

	<!--
	    Ohne diesen Schlüssel wird dem Zubehör-Provider die Freigabe verweigert
	    und ar_session_run scheitert — ohne dass irgendwo ein fehlender
	    Info.plist-Eintrag erwähnt würde. Es erscheint auch keine Rückfrage beim
	    Nutzer, was die Suche zusätzlich in die Irre führt.
	-->
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>Jedi Knight XR verfolgt die Position deiner Controller, damit deine Hände im Spiel dort sind, wo du sie tatsächlich hältst.</string>

	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
